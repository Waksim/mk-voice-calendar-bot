# Copy this file to .env, fill the values, and keep it private.
TELEGRAM_PERSONAL_USER_ID=
TELEGRAM_WORK_USER_ID=

# Required. Contributor pricing permits Meta to use prompts and completions.
OPENROUTER_API_KEY=
# Optional planner settings; these are the application defaults.
OPENROUTER_MODEL=meta/muse-spark-1.2-contributor
OPENROUTER_REASONING_EFFORT=high
OPENROUTER_MAX_TOKENS=8192
OPENROUTER_TIMEOUT_SECONDS=45
