# Copy this file to .env, fill the values, and keep it private.
TELEGRAM_PERSONAL_USER_ID=
TELEGRAM_WORK_USER_ID=

# Shared only by the bot and the isolated local Codex runner. Generate at least
# 32 random URL-safe characters; production uses a dedicated secret file.
CODEX_RUNNER_TOKEN=

# Required for the second and third planner stages.
OPENROUTER_API_KEY=
# Required for the fourth, direct Gemini Developer API stage.
GEMINI_API_KEY=
# Final fallback. This is the Base64 Authorization Key from GigaChat API, not
# the short-lived OAuth access token.
GIGACHAT_CREDENTIALS=

# Optional planner settings; order here matches runtime provider priority.
CODEX_RUNNER_URL=http://127.0.0.1:8091
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=high
CODEX_TIMEOUT_SECONDS=55
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_REASONING_EFFORT=medium
OPENROUTER_TIMEOUT_SECONDS=35
OPENROUTER_FALLBACK_MODEL=z-ai/glm-5.2:free
OPENROUTER_FALLBACK_REASONING_EFFORT=high
OPENROUTER_FALLBACK_TIMEOUT_SECONDS=15
OPENROUTER_MAX_TOKENS=8192
GEMINI_MODEL=gemini-3.7-flash
GEMINI_TIMEOUT_SECONDS=25
GIGACHAT_SCOPE=GIGACHAT_API_CORP
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_CA_BUNDLE_FILE=deploy/server/certs/russian_trusted_root_ca_pem.crt
GIGACHAT_TIMEOUT_SECONDS=45
CALENDAR_PLANNER_TIMEOUT_SECONDS=180

# Optional screenshot/image narration chain. Vision only describes the image
# and transcribes visible text; the calendar planner above decides the CRUD.
OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free
OPENROUTER_VISION_TIMEOUT_SECONDS=15
OPENROUTER_VISION_FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_VISION_FALLBACK_TIMEOUT_SECONDS=12
GEMINI_VISION_MODEL=gemini-3.7-flash
GEMINI_VISION_TIMEOUT_SECONDS=20
VISION_LOCAL_OCR_TIMEOUT_SECONDS=15
VISION_MAX_IMAGE_BYTES=8388608
VISION_MAX_IMAGE_PIXELS=20000000
VISION_MAX_DESCRIPTION_CHARS=4000
VISION_MAX_VISIBLE_TEXT_CHARS=12000
# Production image bakes the PP-OCRv5 ESLAV/Cyrillic ONNX models here.
# Local development may omit this line and use .runtime/rapidocr-models.
# VISION_OCR_MODEL_DIR=/opt/rapidocr-models

# Optional local CLI fallback compatibility.
GEMINI_CLI_PATH=~/.local/bin/agy
GEMINI_CLI_MODEL=gemini-3.7-flash-high
